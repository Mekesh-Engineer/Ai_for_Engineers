{
  "api_providers": {
    "openai": {
      "model": "gpt-4o-mini",
      "temperature": 0.3,
      "max_tokens": 200,
      "api_key_env_var": "OPENAI_API_KEY",
      "timeout_seconds": 30,
      "max_retries": 3
    },
    "anthropic": {
      "model": "claude-3-haiku-20240307",
      "temperature": 0.3,
      "max_tokens": 200,
      "api_key_env_var": "ANTHROPIC_API_KEY",
      "timeout_seconds": 30,
      "max_retries": 3
    },
    "huggingface_inference": {
      "model": "facebook/bart-large-cnn",
      "api_key_env_var": "HF_TOKEN",
      "timeout_seconds": 45,
      "max_retries": 3
    }
  },
  "default_provider": "local_huggingface",
  "rate_limiting": {
    "requests_per_minute": 60,
    "backoff_factor": 2.0
  }
}
