{
  "model": {
    "default_model_name": "sshleifer/distilbart-cnn-12-6",
    "fallback_model_name": "t5-small",
    "high_quality_model_name": "facebook/bart-large-cnn",
    "device": "auto",
    "torch_dtype": "float32"
  },
  "generation": {
    "min_length": 30,
    "max_length": 120,
    "num_beams": 4,
    "temperature": 0.7,
    "top_p": 0.9,
    "length_penalty": 2.0,
    "no_repeat_ngram_size": 3,
    "early_stopping": true,
    "do_sample": false
  },
  "extractive": {
    "num_sentences": 3,
    "algorithm": "textrank_tfidf",
    "similarity_threshold": 0.2
  },
  "evaluation": {
    "metrics": ["rouge1", "rouge2", "rougeL", "bertscore", "compression_ratio", "length_compliance"],
    "rouge_use_stemmer": true
  }
}
